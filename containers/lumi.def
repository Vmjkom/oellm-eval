Bootstrap: localimage
From: /appl/local/laifs/containers/lumi-multitorch-u24r72f21m50t211-20260929_104918/lumi-multitorch-full-u24r72f21m50t211-20260929_104918.sif

%arguments
    JUDGEARENA_GIT_REF=45e3b80705f54463f7b67bdeecd8245413eb7457

%labels
    Author      oellm-cli
    Description Apptainer image for LUMI cluster
    JudgeArenaRef {{ JUDGEARENA_GIT_REF }}

%post
    VIRTUAL_ENV=/opt/venv/lib/python3.12/
    # Install uv
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/bin sh
    export UV_TOOL_BIN_DIR=/usr/bin
    export UV_TOOL_DIR=/opt/uv-tools    # Note to myself; Whenever a tool is installed a seperate venv will be installed here

    # lm-eval and dependencies in the ROCm/PyTorch base venv.
    uv pip install --python /opt/venv/bin/python \
        "lm_eval[api,tasks]>=0.4.12" \
        "judgearena @ git+https://github.com/OpenEuroLLM/JudgeArena.git@{{ JUDGEARENA_GIT_REF }}"


    # Keep lighteval isolated: its ANTLR requirement conflicts with
    # lm-eval's math-task requirement. Its own Torch must be ROCm.
    uv tool install --python 3.12 \
        --torch-backend rocm7.2 \
        --with "langcodes[data]" \
        --with "pillow" \
        --with "xxhash<4" \
        --with "huggingface-hub<2" \
        "lighteval[multilingual] @ git+https://github.com/huggingface/lighteval.git"

    # unset PYTHONPATH    # For some reason this is hardcoded in the base image. This conflicts with the following preloads
    # unset VIRTUAL_ENV
    # NOTE: Currently the NLTK downloads fail:
    # /opt/uv-tools/lighteval/lib/python3.12/site-packages/nltk/downloader.py:1076: UserWarning: NLTK will not authorize the non-private download directory '/opt/nltk_data': it (or an ancestor) is world- or group-writable, \
    # so another local user could plant files there. Choose a private location such as ~/nltk_data.
    # Pre-load lighteval registry to trigger tinyBenchmarks data download at build time
    # /opt/uv-tools/lighteval/bin/python -c "from lighteval.tasks.registry import Registry; Registry.load_all_task_configs(load_multilingual=True)"

    # NLTK data
    # mkdir -p /opt/nltk_data
    # /opt/uv-tools/lighteval/bin/python -c "import nltk; nltk.download('punkt', download_dir='/opt/nltk_data'); nltk.download('punkt_tab', download_dir='/opt/nltk_data')"

%environment
    unset TORCH_NCCL_HIGH_PRIORITY
    export PATH=/usr/bin:$PATH
    export UV_TOOL_BIN_DIR=/usr/bin
    export UV_TOOL_DIR=/opt/uv-tools
    export NLTK_DATA=/opt/nltk_data

